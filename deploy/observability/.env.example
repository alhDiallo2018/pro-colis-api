# Nom du reseau partage cree par le Compose de l'API.
PROCOLIS_DOCKER_NETWORK=procolis-observability-shared
APP_RELEASE=git-sha-or-release-name
FARO_ALLOWED_ORIGIN=https://sendprocolis.example.com
# Prefixe exact present au debut des URL de fichiers minifies dans les stacks.
FARO_SOURCEMAP_PREFIX=https://sendprocolis.example.com/

# Utiliser un role PostgreSQL dedie possedant uniquement pg_monitor. Le mot de
# passe reste dans un secret Docker et ne doit pas etre inclus dans cette URI.
POSTGRES_EXPORTER_URI=postgres:5432/sendprocolis?sslmode=disable
POSTGRES_EXPORTER_USER=procolis_monitor

# Les fichiers reels ne doivent jamais etre committes.
METRICS_TOKEN_FILE=./secrets/metrics_token
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password
BREVO_SMTP_KEY_FILE=./secrets/brevo_smtp_key
POSTGRES_MONITOR_PASSWORD_FILE=./secrets/postgres_monitor_password
ALERTMANAGER_CONFIG_FILE=./alertmanager/alertmanager.yml
