# Depot Restic compatible S3. Le mot de passe Restic et les cles S3 doivent
# etre conserves dans un fichier root-only hors du depot Git.
RESTIC_REPOSITORY=s3:https://s3.example.com/procolis-observability
RESTIC_PASSWORD_FILE=/etc/procolis/restic-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Noms exacts crees par deploy/observability/compose.yml.
LOKI_DOCKER_VOLUME=procolis-observability_loki-data
PROMETHEUS_DOCKER_VOLUME=procolis-observability_prometheus-data
