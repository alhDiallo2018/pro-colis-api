// Catalogue public des lignes de bus DDD / AFTU. Partagé entre tous les chauffeurs ;
// un voyage reste porté par Advertisement (jamais par TransitLine).
model TransitLine {
  id             String            @id @default(uuid()) @db.Uuid
  operator       TransitOperator
  // Shuttle operator qui gère la ligne. Nullable : les lignes seedées
  // (catalogue public DDD/AFTU historique) n'ont pas d'opérateur rattaché.
  operatorUserId String?           @map("operator_user_id") @db.Uuid
  number         String
  direction      TransitDirection
  name           String
  origin         String
  destination    String
  source         String?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  stops          TransitLineStop[]
  advertisements Advertisement[]
  schedules      ShuttleSchedule[]
  operatorUser   User?             @relation("ShuttleOperatorLines", fields: [operatorUserId], references: [id], onDelete: SetNull)

  @@unique([operator, number, direction])
  @@index([operator])
  @@index([operatorUserId])
  @@map("transit_lines")
}

model TransitLineStop {
  transitLineId String      @map("transit_line_id") @db.Uuid
  order         Int
  zoneId        String      @map("zone_id") @db.Uuid
  label         String
  transitLine   TransitLine @relation(fields: [transitLineId], references: [id], onDelete: Cascade)
  zone          Zone        @relation(fields: [zoneId], references: [id])

  @@id([transitLineId, order])
  @@index([zoneId])
  @@map("transit_line_stops")
}

// ─────────────────────────────────────────────────────────────────────────────
// Shuttle operator : flotte de véhicules collectifs rattachés à un opérateur
// (User `shuttle_operator`). Scope ownership strict : les endpoints renvoient
// 404 sur un véhicule détenu par un autre opérateur.
// ─────────────────────────────────────────────────────────────────────────────
model ShuttleVehicle {
  id             String    @id @default(uuid()) @db.Uuid
  operatorUserId String    @map("operator_user_id") @db.Uuid
  plateNumber    String    @map("plate_number")
  model          String
  type           String // bus, minibus, car, van
  capacity       Int       @default(0)
  status         String    @default("available") // available, maintenance, retired
  notes          String?
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  operatorUser User @relation("ShuttleOperatorVehicles", fields: [operatorUserId], references: [id], onDelete: Cascade)

  // Unicité de la plaque *par opérateur* : deux opérateurs peuvent
  // théoriquement enregistrer la même plaque (flottes séparées), mais un
  // même opérateur ne peut pas la dupliquer.
  @@unique([operatorUserId, plateNumber])
  @@index([operatorUserId])
  @@index([status])
  @@map("shuttle_vehicles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Shuttle operator : plages de service récurrentes sur une TransitLine.
// `daysOfWeek` : tableau Int (0 dim → 6 sam) interprété côté API.
// `departureTime` : HH:MM locale Dakar. Pas de fuseau dans la colonne — la
// résolution d'horaire (nuit, DST non applicable à Dakar) reste côté métier.
// ─────────────────────────────────────────────────────────────────────────────
model ShuttleSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  operatorUserId String    @map("operator_user_id") @db.Uuid
  transitLineId  String    @map("transit_line_id") @db.Uuid
  daysOfWeek     Int[]     @map("days_of_week")
  departureTime  String    @map("departure_time") // "HH:MM"
  activeFrom     DateTime  @default(now()) @map("active_from") @db.Timestamptz
  activeUntil    DateTime? @map("active_until") @db.Timestamptz
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  operatorUser User        @relation("ShuttleOperatorSchedules", fields: [operatorUserId], references: [id], onDelete: Cascade)
  transitLine  TransitLine @relation(fields: [transitLineId], references: [id], onDelete: Cascade)

  @@index([operatorUserId])
  @@index([transitLineId])
  @@map("shuttle_schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// P3.15 — Parrainage / fidélité.
// Un filleul (`referreeId`) ne peut être parrainé qu'une seule fois : contrainte
// d'unicité sur `referreeId`. Les montants bonus sont persistés pour permettre
// un recalcul audit sans dépendre des règles courantes.
// ─────────────────────────────────────────────────────────────────────────────
model Referral {
  id               String    @id @default(uuid()) @db.Uuid
  referrerId       String    @map("referrer_id") @db.Uuid
  referreeId       String    @unique @map("referree_id") @db.Uuid
  code             String    @map("code")
  status           String    @default("pending") @map("status")
  // Bonus crédités au déclenchement (en XOF).
  referrerBonusXof Decimal?  @map("referrer_bonus_xof") @db.Decimal(12, 2)
  referreeBonusXof Decimal?  @map("referree_bonus_xof") @db.Decimal(12, 2)
  triggeredAt      DateTime? @map("triggered_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referree User @relation("ReferralReferree", fields: [referreeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────────
// P3.14 — Assurance colis : trace de la souscription à la prime calculée au
// moment de la création du colis. Un colis ne peut avoir qu'une souscription
// active à la fois.
// ─────────────────────────────────────────────────────────────────────────────
model InsuranceSubscription {
  id               String    @id @default(uuid()) @db.Uuid
  parcelId         String    @unique @map("parcel_id") @db.Uuid
  premiumXof       Decimal   @map("premium_xof") @db.Decimal(12, 2)
  coverageXof      Decimal   @map("coverage_xof") @db.Decimal(12, 2)
  declaredValueXof Decimal   @map("declared_value_xof") @db.Decimal(12, 2)
  parcelType       String    @map("parcel_type")
  status           String    @default("active") @map("status")
  exclusions       Json?     @map("exclusions")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("insurance_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// P2.8 — Clés API partenaires e-commerce. Le `keyHash` est le SHA-256 de la
// partie secrète (jamais stockée en clair). Les scopes contrôlent ce que la
// clé peut faire (ex. `shipments.read`, `shipments.write`).
// ─────────────────────────────────────────────────────────────────────────────
model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  keyId         String    @unique @map("key_id")
  keyHash       String    @map("key_hash")
  partnerName   String    @map("partner_name")
  webhookUrl    String?   @map("webhook_url")
  webhookSecret String?   @map("webhook_secret")
  scopes        String[]  @default([]) @map("scopes")
  active        Boolean   @default(true) @map("active")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // NULL = clé partenaire créée par super-admin (historique).
  // Non-NULL = clé self-service d'un business shipper ; seules ces clés
  // sont visibles via `/business-shipper/api-keys/*`.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([createdById])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// Modernisation 2026-11 — Livraison fiable des webhooks sortants. Chaque
// tentative d'envoi est persistée ; en cas d'échec on re-livre avec backoff
// exponentiel (nextAttemptAt). `attempts` et `maxAttempts` bornent la
// boucle. Un worker interne scanne les lignes `pending` dues et marque
// `delivered` ou `dead` au terme.
// ─────────────────────────────────────────────────────────────────────────────
model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  partnerKeyId   String    @map("partner_key_id")
  partnerName    String    @map("partner_name")
  url            String
  secret         String
  eventType      String    @map("event_type")
  payload        Json      @map("payload")
  status         String    @default("pending") @map("status") // pending | delivered | dead
  attempts       Int       @default(0) @map("attempts")
  maxAttempts    Int       @default(6) @map("max_attempts")
  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@index([partnerKeyId])
  @@map("webhook_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Modernisation 2026-11 — Traçabilité des notifications WhatsApp.
// Alimente les compteurs du dashboard pilote (sent / delivered / read).
// Les transitions d'état sont faites par le callback Meta (webhook à
// brancher). Jamais relu pour dédupliquer : un `messageId` Meta par ligne.
// ─────────────────────────────────────────────────────────────────────────────
model WhatsAppDispatch {
  id           String    @id @default(uuid()) @db.Uuid
  messageId    String?   @unique @map("message_id")
  phone        String
  templateName String    @map("template_name")
  parcelId     String?   @map("parcel_id") @db.Uuid
  status       String    @default("sent") @map("status") // sent | delivered | read | failed
  sentAt       DateTime  @default(now()) @map("sent_at") @db.Timestamptz
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz
  readAt       DateTime? @map("read_at") @db.Timestamptz
  failedAt     DateTime? @map("failed_at") @db.Timestamptz
  errorReason  String?   @map("error_reason")

  @@index([status])
  @@index([parcelId])
  @@map("whatsapp_dispatches")
}

// ─────────────────────────────────────────────────────────────────────────────
// Modernisation 2026-11 — Journal des anomalies détectées sur un trajet.
// Alimente la section « anomalies » du dashboard pilote et sert de source
// pour toute analyse rétrospective. Pas de contrainte foreign-key (on ne
// veut pas que la suppression d'un colis casse l'historique métriques).
// ─────────────────────────────────────────────────────────────────────────────
model AnomalyEvent {
  id         String   @id @default(uuid()) @db.Uuid
  parcelId   String?  @map("parcel_id") @db.Uuid
  type       String // gpsSilence | prolongedStop | routeDeviation
  severity   String   @default("info") @map("severity") // info | warning | critical
  details    Json?    @map("details")
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz

  @@index([type, detectedAt])
  @@index([parcelId])
  @@map("anomaly_events")
}
