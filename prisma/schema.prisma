generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  driver
  admin
  super_admin
  support
  support_technique
  support_commercial
}

enum TicketChannel {
  in_app
  phone
  email
}

enum TicketPriority {
  low
  normal
  high
  critical
}

enum TicketStatus {
  open
  pending
  in_progress
  resolved
}

enum IncidentSeverity {
  sev1
  sev2
  sev3
}

enum LeadKind {
  garage
  business_client
  driver_fleet
}

enum LeadStage {
  contacted
  qualified
  negotiation
  signed
}

enum UserStatus {
  active
  suspended
  deleted
}

enum DriverStatus {
  available
  busy
  offline
}

enum ParcelStatus {
  pending
  free
  confirmed
  picked_up
  in_transit
  arrived
  out_for_delivery
  delivered
  cancelled
  proposal_sent
  negotiating
}

enum ParcelType {
  document
  package
  fragile
  perishable
  valuable
}

enum BidStatus {
  pending
  accepted
  rejected
  countered
}

enum MediaType {
  photo
  video
  audio
  signature
  proof
}

enum PaymentMethod {
  wave
  freemMoney
  orange_money
  card
  cash
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum PaymentChannel {
  cash
  platform
}

enum CashCollectionPoint {
  sender_pickup
  receiver_delivery
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum AdvertisementStatus {
  open
  closed
  cancelled
}

enum SupportStatus {
  open
  pending
  closed
}

enum IdentityStatus {
  pending
  approved
  rejected
}

enum BackupStatus {
  pending
  running
  completed
  failed
}

enum WalletStatus {
  active
  suspended
}

enum WalletTransactionType {
  deposit
  commission
  bonus
  adjustment
  refund
  correction
  penalty
  withdrawal
}

enum CommissionProfileType {
  local
  regional
  express
  international
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
  cancelled
}

enum ZoneType {
  CIRCLE
  POLYGON
}

enum ProposalStatus {
  pending
  accepted
  rejected
  countered
  expired
}

enum NegotiationRole {
  client
  driver
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  email                   String?                @unique
  phone                   String                 @unique
  fullName                String                 @map("full_name")
  passwordHash            String?                @map("password_hash")
  pinHash                 String?                @map("pin_hash")
  role                    UserRole
  status                  UserStatus             @default(active)
  profilePhoto            String?                @map("profile_photo")
  address                 String?
  city                    String?
  region                  String?
  gender                  String?
  garageId                String?                @map("garage_id") @db.Uuid
  driverStatus            DriverStatus?          @map("driver_status")
  rating                  Decimal                @default(0) @db.Decimal(3, 2)
  totalDeliveries         Int                    @default(0) @map("total_deliveries")
  completedDeliveries     Int                    @default(0) @map("completed_deliveries")
  cancelledDeliveries     Int                    @default(0) @map("cancelled_deliveries")
  isEmailVerified         Boolean                @default(false) @map("is_email_verified")
  isPhoneVerified         Boolean                @default(false) @map("is_phone_verified")
  isVerified              Boolean                @default(false) @map("is_verified")
  isProfileComplete       Boolean                @default(false) @map("is_profile_complete")
  notificationPreferences Json?                  @map("notification_preferences")
  lastLogin               DateTime?              @map("last_login") @db.Timestamptz
  lastActiveAt            DateTime?              @map("last_active_at") @db.Timestamptz
  deletedAt               DateTime?              @map("deleted_at") @db.Timestamptz
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  garage                  Garage?                @relation(fields: [garageId], references: [id], onDelete: SetNull)
  vehicles                Vehicle[]              @relation("DriverVehicles")
  sentParcels             Parcel[]               @relation("ParcelSender")
  drivenParcels           Parcel[]               @relation("ParcelAssignedDriver")
  createdParcels          Parcel[]               @relation("ParcelCreator")
  cancelledParcels        Parcel[]               @relation("ParcelCanceller")
  proposedParcels         Parcel[]               @relation("ParcelProposedDriver")
  bids                    Bid[]
  parcelEvents            ParcelEvent[]
  parcelMedia             ParcelMedia[]
  payments                Payment[]              @relation("PaymentUser")
  validatedPayments       Payment[]              @relation("PaymentValidator")
  score                   Score?
  scoreTransactions       ScoreTransaction[]
  notifiedTransactions    ScoreTransaction[]     @relation("ScorePerformer")
  notifications           Notification[]         @relation("NotificationRecipient")
  sentNotifications       Notification[]         @relation("NotificationSender")
  otpCodes                OtpCode[]
  refreshTokens           RefreshToken[]
  advertisements          Advertisement[]
  advertisementOffers     AdvertisementOffer[]
  driverLocations         DriverLocation[]
  ratingsGiven            Rating[]               @relation("RatingAuthor")
  ratingsReceived         Rating[]               @relation("RatingDriver")
  supportMessages         SupportMessage[]
  identityVerifications   IdentityVerification[] @relation("IdentityOwner")
  reviewedIdentities      IdentityVerification[] @relation("IdentityReviewer")
  favoriteGarages         FavoriteGarage[]
  favoriteZones           FavoriteZone[]
  addresses               Address[]
  sentMessages            Message[]              @relation("MessageSender")
  receivedMessages        Message[]              @relation("MessageReceiver")
  handledSupportMessages  Message[]              @relation("MessageHandledBy")
  auditLogs               AuditLog[]             @relation("AuditActor")
  systemConfigs           SystemConfig[]
  webhooks                Webhook[]
  backups                 Backup[]
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]
  withdrawals             Withdrawal[]
  driverZones             ZoneDriver[]
  deviceTokens            DeviceToken[]
  expensesCreated         Expense[]              @relation("ExpenseCreatedBy")
  assistances             Assistance[]           @relation("AssistanceUser")
  assistancesHandled      Assistance[]           @relation("AssistanceHandledBy")
  ticketsRequested        SupportTicket[]        @relation("TicketRequester")
  ticketsAssigned         SupportTicket[]        @relation("TicketAssignee")
  incidentsCreated        PlatformIncident[]     @relation("IncidentCreatedBy")
  commercialLeads         CommercialLead[]       @relation("LeadOwner")
  commercialObjectives    CommercialObjective[]  @relation("ObjectiveOwner")
  negotiationMessages     NegotiationMessage[]   @relation("NegotiationSender")

  @@map("users")
}

model Garage {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  country          String?
  city             String
  region           String
  address          String?
  phone            String?
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  isActive         Boolean          @default(true) @map("is_active")
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  users            User[]
  vehicles         Vehicle[]
  departureParcels Parcel[]         @relation("DepartureGarage")
  arrivalParcels   Parcel[]         @relation("ArrivalGarage")
  departingAds     Advertisement[]  @relation("AdvertisementDepartureGarage")
  arrivingAds      Advertisement[]  @relation("AdvertisementArrivalGarage")
  favoriteBy       FavoriteGarage[]

  @@index([isActive])
  @@map("garages")
}

model Vehicle {
  id          String    @id @default(uuid()) @db.Uuid
  plateNumber String    @unique @map("plate_number")
  model       String
  type        String
  capacity    Int       @default(0)
  garageId    String?   @map("garage_id") @db.Uuid
  driverId    String?   @map("driver_id") @db.Uuid
  isAvailable Boolean   @default(true) @map("is_available")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  garage      Garage?   @relation(fields: [garageId], references: [id])
  driver      User?     @relation("DriverVehicles", fields: [driverId], references: [id], onDelete: SetNull)

  @@map("vehicles")
}

model Parcel {
  id                    String               @id @default(uuid()) @db.Uuid
  trackingNumber        String               @unique @map("tracking_number")
  senderId              String?              @map("sender_id") @db.Uuid
  senderName            String               @map("sender_name")
  senderPhone           String               @map("sender_phone")
  senderEmail           String?              @map("sender_email")
  receiverName          String               @map("receiver_name")
  receiverPhone         String               @map("receiver_phone")
  receiverEmail         String?              @map("receiver_email")
  receiverAddress       String?              @map("receiver_address")
  description           String
  weight                Decimal              @db.Decimal(10, 2)
  length                Decimal?             @db.Decimal(10, 2)
  width                 Decimal?             @db.Decimal(10, 2)
  height                Decimal?             @db.Decimal(10, 2)
  type                  ParcelType           @default(package)
  status                ParcelStatus         @default(pending)
  departureGarageId     String?              @map("departure_garage_id") @db.Uuid
  arrivalGarageId       String?              @map("arrival_garage_id") @db.Uuid
  departureZoneId       String?              @map("departure_zone_id") @db.Uuid
  arrivalZoneId         String?              @map("arrival_zone_id") @db.Uuid
  proposedDriverId      String?              @map("proposed_driver_id") @db.Uuid
  assignedDriverId      String?              @map("assigned_driver_id") @db.Uuid
  price                 Decimal?             @db.Decimal(12, 2)
  proposedPrice         Decimal?             @map("proposed_price") @db.Decimal(12, 2)
  negotiatedPrice       Decimal?             @map("negotiated_price") @db.Decimal(12, 2)
  deliveryFees          Decimal?             @map("delivery_fees") @db.Decimal(12, 2)
  totalAmount           Decimal?             @map("total_amount") @db.Decimal(12, 2)
  isInsured             Boolean              @default(false) @map("is_insured")
  insuranceAmount       Decimal?             @map("insurance_amount") @db.Decimal(12, 2)
  isUrgent              Boolean              @default(false) @map("is_urgent")
  urgentFee             Decimal?             @map("urgent_fee") @db.Decimal(12, 2)
  isFreeForBidding      Boolean              @default(false) @map("is_free_for_bidding")
  selectedBidId         String?              @map("selected_bid_id") @db.Uuid
  paymentMethod         PaymentMethod?       @map("payment_method")
  paymentChannel        PaymentChannel?      @map("payment_channel")
  acceptedPaymentChannels PaymentChannel[]   @default([]) @map("accepted_payment_channels")
  cashCollectionPoint   CashCollectionPoint? @map("cash_collection_point")
  cashCollectedAmount   Decimal?             @map("cash_collected_amount") @db.Decimal(12, 2)
  cashCollectedAt       DateTime?            @map("cash_collected_at") @db.Timestamptz
  paymentPhoneNumber    String?              @map("payment_phone_number")
  paymentStatus         String?              @map("payment_status")
  signatureUrl          String?              @map("signature_url")
  notes                 String?
  pickupDate            DateTime?            @map("pickup_date") @db.Timestamptz
  deliveryDate          DateTime?            @map("delivery_date") @db.Timestamptz
  estimatedDeliveryDate DateTime?            @map("estimated_delivery_date") @db.Timestamptz
  createdBy             String?              @map("created_by") @db.Uuid
  cancelledBy           String?              @map("cancelled_by") @db.Uuid
  cancellationReason    String?              @map("cancellation_reason")
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  sender                User?                @relation("ParcelSender", fields: [senderId], references: [id], onDelete: SetNull)
  proposedDriver        User?                @relation("ParcelProposedDriver", fields: [proposedDriverId], references: [id], onDelete: SetNull)
  assignedDriver        User?                @relation("ParcelAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  creator               User?                @relation("ParcelCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  canceller             User?                @relation("ParcelCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
  departureGarage       Garage?              @relation("DepartureGarage", fields: [departureGarageId], references: [id])
  arrivalGarage         Garage?              @relation("ArrivalGarage", fields: [arrivalGarageId], references: [id])
  departureZone         Zone?                @relation("ParcelDepartureZone", fields: [departureZoneId], references: [id])
  arrivalZone           Zone?                @relation("ParcelArrivalZone", fields: [arrivalZoneId], references: [id])
  selectedBid           Bid?                 @relation("SelectedBid", fields: [selectedBidId], references: [id], onDelete: SetNull)
  bids                  Bid[]                @relation("ParcelBids")
  proposalStatus        ProposalStatus?      @map("proposal_status")
  proposalPrice         Decimal?             @map("proposal_price") @db.Decimal(12, 2)
  lastCounterPrice      Decimal?             @map("last_counter_price") @db.Decimal(12, 2)
  lastOfferBy           NegotiationRole?     @map("last_offer_by")
  negotiationCount      Int                  @default(0) @map("negotiation_count")
  events                ParcelEvent[]
  media                 ParcelMedia[]
  payments              Payment[]
  scoreTransactions     ScoreTransaction[]
  walletTransactions    WalletTransaction[]
  notifications         Notification[]
  advertisementOffers   AdvertisementOffer[]
  driverLocations       DriverLocation[]
  ratings               Rating[]
  messages              Message[]
  negotiationMessages   NegotiationMessage[]

  @@index([senderId])
  @@index([proposedDriverId])
  @@index([assignedDriverId])
  @@index([status])
  @@index([trackingNumber])
  @@index([departureGarageId])
  @@index([arrivalGarageId])
  @@map("parcels")
}

model Bid {
  id              String         @id @default(uuid()) @db.Uuid
  parcelId        String         @map("parcel_id") @db.Uuid
  driverId        String         @map("driver_id") @db.Uuid
  price           Decimal        @db.Decimal(12, 2)
  message         String?
  status          BidStatus      @default(pending)
  responseMessage String?        @map("response_message")
  audioUrl        String?        @map("audio_url")
  respondedAt     DateTime?      @map("responded_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  parcel          Parcel         @relation("ParcelBids", fields: [parcelId], references: [id], onDelete: Cascade)
  driver          User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  selectedParcels Parcel[]       @relation("SelectedBid")
  notifications   Notification[]
  negotiationMessages NegotiationMessage[]
  isDirectProposal Boolean       @default(false) @map("is_direct_proposal")
  parentProposalId String?       @map("parent_proposal_id") @db.Uuid
  lastOfferBy      NegotiationRole? @map("last_offer_by")
  parentProposal  Bid?           @relation("BidProposalHierarchy", fields: [parentProposalId], references: [id], onDelete: SetNull)
  childProposals  Bid[]          @relation("BidProposalHierarchy")

  @@unique([parcelId, driverId])
  @@index([parcelId])
  @@index([driverId])
  @@map("bids")
}

model NegotiationMessage {
  id            String   @id @default(uuid()) @db.Uuid
  // Un echange appartient soit a une enchere, soit a une proposition directe
  // (le client choisit son chauffeur) : les deux fils partagent la meme table.
  bidId         String?  @map("bid_id") @db.Uuid
  fromUserId    String   @map("from_user_id") @db.Uuid
  fromUserRole  String   @map("from_user_role")
  price         Decimal  @db.Decimal(12, 2)
  message       String?
  parcelId      String?  @map("parcel_id") @db.Uuid
  isCounterOffer Boolean @default(false) @map("is_counter_offer")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  bid           Bid?     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  fromUser      User     @relation("NegotiationSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  parcel        Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([bidId])
  @@index([parcelId])
  @@index([fromUserId])
  @@index([createdAt])
  @@map("negotiation_messages")
}

model ParcelEvent {
  id          String   @id @default(uuid()) @db.Uuid
  parcelId    String   @map("parcel_id") @db.Uuid
  status      String
  description String
  location    String?
  locationLat Decimal? @map("location_lat") @db.Decimal(10, 7)
  locationLng Decimal? @map("location_lng") @db.Decimal(10, 7)
  userId      String?  @map("user_id") @db.Uuid
  userName    String?  @map("user_name")
  userRole    String?  @map("user_role")
  photoUrl    String?  @map("photo_url")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  parcel      Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([parcelId, createdAt])
  @@map("parcel_events")
}

model ParcelMedia {
  id              String    @id @default(uuid()) @db.Uuid
  parcelId        String    @map("parcel_id") @db.Uuid
  uploadedBy      String?   @map("uploaded_by") @db.Uuid
  mediaType       MediaType @map("media_type")
  url             String
  filename        String?
  mimeType        String?   @map("mime_type")
  sizeBytes       BigInt?   @map("size_bytes")
  durationSeconds Int?      @map("duration_seconds")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  parcel          Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  uploader        User?     @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("parcel_media")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  parcelId      String?       @map("parcel_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("XOF")
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  transactionId String?       @unique @map("transaction_id")
  phoneNumber   String?       @map("phone_number")
  reference     String?       @unique
  metadata      Json          @default("{}")
  receiptUrl    String?       @map("receipt_url")
  validatedBy   String?       @map("validated_by") @db.Uuid
  validatedAt   DateTime?     @map("validated_at") @db.Timestamptz
  completedAt   DateTime?     @map("completed_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user          User          @relation("PaymentUser", fields: [userId], references: [id])
  parcel        Parcel?       @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  validator     User?         @relation("PaymentValidator", fields: [validatedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([parcelId])
  @@map("payments")
}

model Score {
  userId      String   @id @map("user_id") @db.Uuid
  points      Int      @default(0)
  totalEarned Int      @default(0) @map("total_earned")
  totalSpent  Int      @default(0) @map("total_spent")
  lastUpdated DateTime @default(now()) @map("last_updated") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scores")
}

model ScoreTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amount      Int
  type        String
  source      String?
  parcelId    String?  @map("parcel_id") @db.Uuid
  description String
  status      String   @default("completed")
  performedBy String?  @map("performed_by") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcel      Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  actor       User?    @relation("ScorePerformer", fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("score_transactions")
}

model Wallet {
  userId               String              @id @map("user_id") @db.Uuid
  balance              Decimal             @default(0) @db.Decimal(12, 2)
  pendingBalance       Decimal             @default(0) @map("pending_balance") @db.Decimal(12, 2)
  totalDeposited       Decimal             @default(0) @map("total_deposited") @db.Decimal(12, 2)
  totalSpent           Decimal             @default(0) @map("total_spent") @db.Decimal(12, 2)
  totalRefunded        Decimal             @default(0) @map("total_refunded") @db.Decimal(12, 2)
  totalWithdrawn       Decimal             @default(0) @map("total_withdrawn") @db.Decimal(12, 2)
  totalCommissionsPaid Decimal             @default(0) @map("total_commissions_paid") @db.Decimal(12, 2)
  status               WalletStatus        @default(active)
  lastDepositAt        DateTime?           @map("last_deposit_at") @db.Timestamptz
  lastActivityAt       DateTime?           @map("last_activity_at") @db.Timestamptz
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         WalletTransaction[]
  withdrawals          Withdrawal[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  walletUserId  String                @map("wallet_user_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceBefore Decimal               @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  parcelId      String?               @map("parcel_id") @db.Uuid
  description   String?
  origin        String?
  status        String                @default("completed")
  performedBy   String?               @map("performed_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  wallet        Wallet                @relation(fields: [walletUserId], references: [userId], onDelete: Cascade)
  parcel        Parcel?               @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  admin         User?                 @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([walletUserId, createdAt])
  @@map("wallet_transactions")
}

model Withdrawal {
  id            String           @id @default(uuid()) @db.Uuid
  walletUserId  String           @map("wallet_user_id") @db.Uuid
  amount        Decimal          @db.Decimal(12, 2)
  method        String           @default("wave")
  phone         String?
  status        WithdrawalStatus @default(pending)
  reference     String?          @unique
  failureReason String?          @map("failure_reason")
  disburseToken String?          @unique @map("disburse_token")
  transactionId String?          @map("transaction_id")
  providerRef   String?          @map("provider_ref")
  requestedAt   DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  processedBy   String?          @map("processed_by") @db.Uuid
  processedAt   DateTime?        @map("processed_at") @db.Timestamptz
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  wallet        Wallet           @relation(fields: [walletUserId], references: [userId], onDelete: Cascade)
  processor     User?            @relation(fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([walletUserId, createdAt])
  @@index([status])
  @@map("withdrawals")
