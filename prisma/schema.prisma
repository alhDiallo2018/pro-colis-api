  @@index([walletUserId, createdAt])
  @@index([status])
  @@map("withdrawals")
}

// Pénalité d'annulation client impayée (FCFA). Dette dédiée, strictement
// séparée de `Wallet.commissionDebt` (dette de commission chauffeur) : le client
// n'a pas de wallet préfinancé. La pénalité non couverte par un remboursement
// (espèces, colis non payé, remboursement nul) devient une ligne ici, réglée
// directement via PayDunya (type `penalty_debt`), sans wallet ni commission.
model ClientPenaltyDebt {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  parcelId  String           @map("parcel_id") @db.Uuid
  // Pénalité initiale au moment de l'annulation (immuable).
  amount    Decimal          @db.Decimal(12, 2)
  // Reliquat restant à régler. `amount` à la création, décrémenté au règlement.
  remaining Decimal          @db.Decimal(12, 2)
  status    ClientDebtStatus @default(pending)
  // Référence stable de suivi (affichage, réconciliation).
  reference String           @unique
  // Motif d'annulation à l'origine de la dette (traçabilité).
  reason    String?
  metadata  Json             @default("{}")
  settledAt DateTime?        @map("settled_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([parcelId])
  @@map("client_penalty_debts")
}

