// Une session GPS lie un véhicule physique à UN départ, jamais à un numéro de ligne.
model JourneyLive {
  id              String        @id @default(uuid()) @db.Uuid
  advertisementId String        @unique @map("advertisement_id") @db.Uuid
  driverId        String        @unique @map("driver_id") @db.Uuid
  vehicleId       String        @unique @map("vehicle_id") @db.Uuid
  latitude        Decimal       @db.Decimal(10, 7)
  longitude       Decimal       @db.Decimal(10, 7)
  accuracyMeters  Float         @map("accuracy_meters")
  capturedAt      DateTime      @map("captured_at") @db.Timestamptz
  // Ring buffer des N dernières positions GPS (JSON array de { lat, lng, t })
  // alimenté par updateJourneyLive. Sert à la détection d'arrivée aux arrêts
  // (confirmation par consécutivité) sans table d'historique dédiée.
  recentPositions Json          @default("[]") @map("recent_positions")
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  driver          User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("journey_live")
}

// Expéditions groupées : regroupement commercial de N colis sous une entité
// commune (B2B ou import e-commerce). Les colis restent individuels avec
// leur propre tracking, mais partagent un référentiel commun pour la
// facturation consolidée et le suivi global.
model ShipmentBatch {
  id            String    @id @default(uuid()) @db.Uuid
  creatorId     String    @map("creator_id") @db.Uuid
  apiKeyId      String?   @map("api_key_id")
  reference     String?
  label         String?
  // draft | open | closed | cancelled (CHECK en base).
  status        String    @default("draft")
  totalParcels  Int       @default(0) @map("total_parcels")
  totalWeightKg Decimal   @default(0) @map("total_weight_kg") @db.Decimal(12, 2)
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(14, 2)
  currency      String?
  metadata      Json      @default("{}")
  closedAt      DateTime? @map("closed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  parcels Parcel[]

  @@index([creatorId])
  @@index([status])
  @@index([reference])
  @@map("shipment_batches")
}

// Déclarations douanières structurées (SCP-040). Relation 1:1 avec Parcel.
// Minimum pour expéditions internationales : pays, contenu, valeur, HS code,
// usage (commercial/gift/sample/personal/return), documents scannés.
model ParcelCustoms {
  id                  String    @id @default(uuid()) @db.Uuid
  parcelId            String    @unique @map("parcel_id") @db.Uuid
  originCountry       String    @map("origin_country")
  destinationCountry  String    @map("destination_country")
  contentsDescription String    @map("contents_description")
  hsCode              String?   @map("hs_code")
  declaredValue       Decimal   @map("declared_value") @db.Decimal(14, 2)
  declaredCurrency    String    @default("XOF") @map("declared_currency")
  weightKg            Decimal?  @map("weight_kg") @db.Decimal(10, 2)
  quantity            Int       @default(1)
  category            String?
  // commercial | gift | sample | personal | return (CHECK en base).
  purpose             String    @default("personal")
  isDangerous         Boolean   @default(false) @map("is_dangerous")
  documentsUrls       Json      @default("[]") @map("documents_urls")
  signedAt            DateTime? @map("signed_at") @db.Timestamptz
  signedById          String?   @map("signed_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  signedBy User?  @relation("ParcelCustomsSignedBy", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([destinationCountry])
  @@index([originCountry])
  @@map("parcel_customs")
}

// Correspondances inter-véhicules : transfert de responsabilité d'un colis
// d'un chauffeur sortant vers un chauffeur entrant avec preuve réciproque.
// Un seul handover actif par colis (contrainte unique partielle gérée par
// un index SQL WHERE status = 'pending_pickup').
model ParcelHandover {
  id                  String    @id @default(uuid()) @db.Uuid
  parcelId            String    @map("parcel_id") @db.Uuid
  fromDriverId        String    @map("from_driver_id") @db.Uuid
  toDriverId          String    @map("to_driver_id") @db.Uuid
  fromAdvertisementId String?   @map("from_advertisement_id") @db.Uuid
  toAdvertisementId   String?   @map("to_advertisement_id") @db.Uuid
  latitude            Decimal?  @db.Decimal(10, 7)
  longitude           Decimal?  @db.Decimal(10, 7)
  initiatedAt         DateTime  @default(now()) @map("initiated_at") @db.Timestamptz
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz
  // pending_pickup | completed | cancelled (CHECK en base).
  status              String    @default("pending_pickup")
  // Hash SHA-256 du PIN et du QR token. Les valeurs claires ne sont jamais
  // persistées : elles sortent une seule fois côté réponse HTTP d'initiate.
  pickupPinHash       String    @map("pickup_pin_hash")
  pickupQrTokenHash   String    @map("pickup_qr_token_hash")
  pickupPinLast4      String?   @map("pickup_pin_last4")
  pickupProofType     String?   @map("pickup_proof_type")
  cancellationReason  String?   @map("cancellation_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parcel            Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  fromDriver        User           @relation("ParcelHandoverFromDriver", fields: [fromDriverId], references: [id], onDelete: Cascade)
  toDriver          User           @relation("ParcelHandoverToDriver", fields: [toDriverId], references: [id], onDelete: Cascade)
  fromAdvertisement Advertisement? @relation("ParcelHandoverFromAd", fields: [fromAdvertisementId], references: [id], onDelete: SetNull)
  toAdvertisement   Advertisement? @relation("ParcelHandoverToAd", fields: [toAdvertisementId], references: [id], onDelete: SetNull)

  @@index([parcelId])
  @@index([toDriverId])
  @@index([fromDriverId])
  @@index([status])
  @@map("parcel_handovers")
}

// Journal immuable des arrêts atteints pendant un trajet navette. Unique
// (advertisement_id, stop_order) : un arrêt n'est marqué qu'une fois.
