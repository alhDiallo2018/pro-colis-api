NODE_ENV=development
PORT=8080
API_PORT=18081
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durees au format <nombre><s|m|h|d>. `expires_at` en base est calcule a partir
# de ces memes valeurs : les modifier suffit a raccourcir reellement la session.
JWT_ACCESS_EXPIRES_IN=15m
# Clients et chauffeurs.
JWT_REFRESH_EXPIRES_IN=30d
# Comptes staff (admin, support, support_technique, support_commercial,
# super_admin) : ils lisent les donnees de toute la plateforme.
JWT_REFRESH_EXPIRES_IN_STAFF=12h
# Inactivite serveur : clients/chauffeurs puis comptes staff. A mettre a jour
# explicitement sur les deploiements qui definissaient encore 1m.
# Le verrouillage biometrique mobile est independant de ces durees.
SESSION_IDLE_TIMEOUT=30d
SESSION_IDLE_TIMEOUT_STAFF=30m
REFRESH_RETRY_GRACE_SECONDS=60
# Presence support : heartbeat toutes les 20 s, reprise apres 90 s sans signal.
SUPPORT_PRESENCE_TTL_SECONDS=90
OTP_EXPIRES_MINUTES=10
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=uploads
# Origine publique de l'API, sans /api/v1 : utilisée pour callback_url PayDunya.
# En production : https://sendprocolis.com (localhost n'est pas joignable par PayDunya).
PUBLIC_BASE_URL=http://localhost:18081
# Origine du frontend web utilisée pour les redirections PayDunya (return/cancel).
# En production : https://sendprocolis.com (jamais une URL locale).
WEB_APP_URL=https://sendprocolis.com
LOG_LEVEL=info
APP_RELEASE=development
LOKI_BASE_URL=http://loki:3100
PROMETHEUS_BASE_URL=http://prometheus:9090
OBSERVABILITY_TIMEOUT_MS=5000
# Obligatoire en production (32 caracteres minimum). Le meme secret est lu
# par Prometheus depuis deploy/observability/secrets/metrics_token.
METRICS_TOKEN=replace-with-at-least-32-random-characters
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# === Sauvegardes PostgreSQL ===
# Repertoire des dumps pg_dump, monte sur un volume persistant par le compose.
BACKUP_DIR=backups
# Nombre de dumps conserves ; les plus anciens sont purges apres chaque
# sauvegarde reussie (fichier et ligne d'historique).
BACKUP_RETENTION=7
# Une restauration ecrase toute la base. Laisser "false" en production et ne
# l'activer que le temps de l'operation : la confirmation "RESTORE" saisie dans
# l'interface ne suffit volontairement pas.
BACKUP_ALLOW_RESTORE=false
# A renseigner seulement si les binaires ne sont pas dans le PATH.
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore

BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@sendprocolis.com
BREVO_SENDER_NAME=PRO COLIS
BREVO_SMS_SENDER=ProColis

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_DISBURSE_BASE_URL=https://app.paydunya.com/api/v2/disburse
# Numéro de compte marchand à débiter pour un déboursement compte à compte
# (withdraw_mode "paydunya"). Vide, PayDunya débite le compte par défaut du pays
# du bénéficiaire (risque d'erreur 4002 si celui-ci n'est pas approvisionné).
PAYDUNYA_DEBIT_ACCOUNT_NUMBER=
# Montant minimum encaissement (pay-in) et retrait (pay-out) en XOF
PAYDUNYA_MIN_AMOUNT=200
PAYDUNYA_MIN_WITHDRAWAL=500
# Exiger l'identité vérifiée (KYC) pour enchérir / publier une annonce ("true"/"false")
REQUIRE_DRIVER_VERIFICATION=false

# Mise a jour Android : GET /api/v1/public/mobile-update (public, sans BD).
# Activer seulement quand la version est disponible pour tous sur le Play Store.
MOBILE_ANDROID_UPDATE_ENABLED=false
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_LATEST_VERSION_CODE=6
# Code installe < MIN : obligatoire ; MIN <= code < LATEST : optionnelle.
MOBILE_ANDROID_MIN_VERSION_CODE=0
MOBILE_ANDROID_RELEASE_NOTES_FR=""
MOBILE_ANDROID_RELEASE_NOTES_EN=""
MOBILE_ANDROID_REMIND_AFTER_HOURS=24
MOBILE_ANDROID_UPDATE_URL=https://play.google.com/store/apps/details?id=com.sendprocolis.app

#firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json                                                                                                                                                 
FIREBASE_PROJECT_ID=ton-projet-id
GOOGLE_MAPS_API_KEY=

# Client OAuth de type Web, commun au SDK Android et a la verification API.
# Vide = connexion Google desactivee ; aucun secret OAuth dans le mobile.
GOOGLE_WEB_CLIENT_ID=856894814285-liup8k5nqvth5f10h2bcnd82obc4v5vi.apps.googleusercontent.com
